#!/usr/bin/env bash
# Refuse to push draft/* branches: they hold rough paper drafts and are local only.
# Squash a draft onto main before pushing.
#
# Install (once per clone):  git config core.hooksPath .githooks
# Run: invoked by git on push; stdin lines are
#   <local ref> <local sha> <remote ref> <remote sha>
# Output: exit 1 (push aborted) if any pushed ref is a draft/* branch.
#         Deleting a remote draft/* branch (local sha all zeros) is allowed,
#         so a leaked draft can be removed.
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref _; do
  [ "$local_sha" = "$zero" ] && continue
  for ref in "$local_ref" "$remote_ref"; do
    case "$ref" in
      refs/heads/draft/*)
        echo "pre-push: refusing to push $ref (draft/* branches are local only)" >&2
        status=1
        break
        ;;
    esac
  done
done
exit $status
